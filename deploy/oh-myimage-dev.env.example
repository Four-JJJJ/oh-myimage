# Copy to /etc/oh-myimage-dev/oh-myimage-dev.env on the target host.
# Do not commit real secrets.

HOST="0.0.0.0"
PORT="8788"
NODE_REQUEST_TIMEOUT_MS="700000"
NODE_GENERATION_WORKER_CONCURRENCY="2"
OH_MYIMAGE_POSTGRES_PASSWORD="change-me"
DATABASE_URL="postgres://oh_myimage:change-me@oh-myimage-dev-postgres:5432/oh_myimage_dev"
REDIS_URL="redis://oh-myimage-dev-redis:6379"

R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="oh-myimage-dev-images"
R2_ENDPOINT=""

APP_ENCRYPTION_KEY="generate-a-dev-only-32-byte-random-value"
TURNSTILE_SECRET_KEY=""

DEFAULT_IMAGE_MODEL="gpt-image-2"
PROMPT_OPTIMIZER_MODEL="gpt-5.5"
MAX_IMAGES_PER_REQUEST="4"
MAX_DAILY_IMAGES_PER_SPACE="100"
MAX_RUNNING_JOBS_PER_SPACE="4"
REQUEST_TIMEOUT_MS="600000"
GENERATION_JOB_MAX_RUNTIME_MS="840000"
PROVIDER_IMAGE_CONCURRENCY="1"
PROVIDER_TIMEOUT_RETRY_ATTEMPTS="0"
PROVIDER_RETRY_ATTEMPTS="0"
PROVIDER_RETRY_DELAY_SECONDS="10"
POST_PROCESSING_RETRY_ATTEMPTS="2"
POST_PROCESSING_RETRY_DELAY_SECONDS="5"
IMAGE_RETENTION_DAYS="14"
X_BEARER_TOKEN=""
INSPIRATION_FEATURE_ENABLED="false"
INSPIRATION_MAX_ITEMS_PER_RUN="12"
INSPIRATION_THUMBNAIL_MAX_BYTES="1048576"
INSPIRATION_AUTO_PUBLISH_SOURCES="civitai"
TURNSTILE_REQUIRED="false"
TURNSTILE_SITE_KEY=""
