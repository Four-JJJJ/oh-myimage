{
  "name": "image-2-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --local",
    "dev:preview": "vite --host 127.0.0.1 --port 5173",
    "dev:node": "npm run build && node dist-node/server.js",
    "build": "npm run build:client && npm run build:node",
    "build:client": "vite build",
    "build:node": "esbuild src/node/server.ts src/node/worker.ts src/node/cron.ts src/node/migrate.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-node --sourcemap",
    "push:dev": "bash scripts/push-dev.sh",
    "deploy": "npm run build && wrangler deploy",
    "start:node": "node dist-node/server.js",
    "worker:node": "node dist-node/worker.js",
    "cron:node": "node dist-node/cron.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply image-2-platform --local",
    "db:migrate:remote": "wrangler d1 migrations apply image-2-platform --remote",
    "db:migrate:postgres": "node dist-node/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1046.0",
    "@aws-sdk/s3-request-presigner": "^3.1046.0",
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@hono/node-server": "^2.0.2",
    "border-beam": "^1.2.0",
    "bullmq": "^5.76.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.26",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/node": "^25.7.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^6.4.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.90.1"
  }
}
